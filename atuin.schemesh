;; TODO: (c-pid-get)
;; TODO: signal handling

(when (or (string=? (sh-env-ref #t "ATUIN_SESSION") "")
          (not (string=? (sh-env-ref #t "ATUIN_SHLVL") (sh-env-ref #t "SHLVL"))))
  (sh-env-set! #t "ATUIN_SESSION" (sh-run/string-rtrim-newlines {atuin uuid}) 'export)
  (sh-env-set! #t "ATUIN_SHLVL" (sh-env-ref #t "SHLVL")) 'export)
;; assign a unique ATUIN_SESSION to each shell session

(define _atuin-before-parse
  (lambda (cmd)
    (unless (string=? cmd "")
      (sh-env-set!
        #t
        "ATUIN_HISTORY_ID"
        (sh-run/string-rtrim-newlines
          {
            ATUIN_SHELL=schemesh \
            atuin history start --hook \
            -- (values cmd) 2>/dev/null
          }
        )
        'export))))

(let ((repl-original-parse (repl-current-parse)))
  (repl-current-parse
    (lambda (lctx initial-parser str)
      (_atuin-before-parse str)
      (repl-original-parse lctx initial-parser str))))

(define _repl-eval-result->exit-status
  (lambda (result)
    (if (status? (car result))
        (let* ((status (car result))
               (value (status->value status)))
          (cond
            ((ok? status) 0)
            ((and (fixnum? value) (fx<=? 1 value 255)) value)
            (else 255)))
        0)))
;; NOTE: signal handling is missing; e.g. SIGINT should return 130, but currently returns 255

(define _time-duration->duration-nanosecond
  (lambda (time-duration)
    (+ (* (time-second time-duration) (expt 10 9))
       (time-nanosecond time-duration))))

(define _atuin-after-eval
  (lambda (exit-status duration-nanosecond)
    (unless (string=? (sh-env-ref #t "ATUIN_HISTORY_ID") "")
      (sh-run
        ;; we use a subshell here
        {[
          atuin history end --hook \
          --exit (number->string exit-status) \
          --duration (number->string duration-nanosecond) \
          -- $ATUIN_HISTORY_ID >/dev/null 2>&1 &
        ]}
      )
      (sh-env-delete! #t "ATUIN_HISTORY_ID"))))

(let ((repl-original-eval (repl-current-eval)))
  (repl-current-eval
    (lambda (form env)
      ;; we use let* here to evaluate its bindings in sequence
      (let* ((time-before-eval (current-time))
             (vals (repl-original-eval form env))
             (time-after-eval (current-time)))
        (_atuin-after-eval
          (_repl-eval-result->exit-status vals)
          (_time-duration->duration-nanosecond
            (time-difference time-after-eval time-before-eval)))
        vals))))

(define _atuin-search
  (lambda (lctx ctrlr-or-uparrow)
    (let* ((input (vlines->string (linectx-vscreen lctx)))
           (job
            (shell
              "ATUIN_SHELL" = "schemesh"
              "ATUIN_QUERY" = (values input)
              "atuin" "search" "--interactive"
              (cond
                ((eq? ctrlr-or-uparrow 'ctrlr) '())
                ((eq? ctrlr-or-uparrow 'uparrow) "--shell-up-key-binding"))
              3 >& "1" 1 >& "2" 2 >& "3" 3 >& "-"
            ))
           (output (sh-run/string-rtrim-newlines job)))
      (linectx-redraw-all lctx) ; required for inline mode
      (cond
        ((string=? output "") (void))
        ((string-prefix? output "__atuin_accept__:")
         (linectx-clear! lctx)
         (linectx-insert/string! lctx (string-replace-prefix output "__atuin_accept__:" ""))
         (linectx-return-set! lctx #t))
        (else
         (linectx-clear! lctx)
         (linectx-insert/string! lctx output))))))

(define atuin-search-ctrlr
  (lambda (lctx)
    (_atuin-search lctx 'ctrlr)))

(define atuin-search-uparrow
  (lambda (lctx)
    (if (fx>? (linectx-iy lctx) 0)
      (vscreen-cursor-move/up! (linectx-vscreen lctx) 1)
      (_atuin-search lctx 'uparrow))))

(linectx-keytable-insert! linectx-default-keytable
  atuin-search-ctrlr
  "\x12;") ; ctrl-r

(linectx-keytable-insert! linectx-default-keytable
  atuin-search-uparrow
  "\x1b;[A") ; up-arrow

